# Vite dev server /api sorğularını bu backend-ə yönləndirir (lokal Django üçün: http://127.0.0.1:8000)
VITE_API_TARGET=https://hesabcheck.testgrelo.online

# Brauzerdə giriş ekranı yoxdur: dev server backend-ə bu hesabla özü qoşulur.
# Bu dəyişənlər yalnız dev serverdə qalır, brauzerə ötürülmür. .env faylı git-ə düşmür.
HESABCHECK_USERNAME=
HESABCHECK_PASSWORD=
# Alternativ: hazır token (doldurulubsa istifadəçi adı/şifrə istifadə olunmur)
HESABCHECK_TOKEN=

# Boş saxlayın: sorğular proxy üzərindən gedir.
VITE_API_BASE_URL=
